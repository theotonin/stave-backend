DATABASE_URL="postgresql://usuario:senha@localhost:5432/stave?schema=public"
PORT=5000

# Preencha a chave somente em backend/.env (não neste exemplo).
# Obtenha em https://aistudio.google.com/apikey usando um projeto no plano gratuito.
GEMINI_API_KEY="cole-sua-chave-aqui"
GEMINI_MODEL="gemini-3.5-flash-lite"

# Opcional: caminho absoluto do Python com Demucs instalado.
DEMUCS_PYTHON=""
